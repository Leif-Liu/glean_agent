# Glean Configuration
GLEAN_INSTANCE=your-company-instance
GLEAN_CLIENT_API_TOKEN=glean_client_abc123...
GLEAN_INDEXING_TOKEN=glean_indexing_xyz456...

# Optional: Act as another user (for Global Token usage)
# GLEAN_ACT_AS=user@company.com

# Agent Configuration
MAX_SEARCH_RESULTS=10
DEFAULT_SEARCH_MODE=hybrid
ENABLE_DEEP_SEARCH=true
SEARCH_TIMEOUT=30
ENABLE_CACHING=true
CACHE_TTL_SECONDS=3600
MAX_CONCURRENT_SEARCHES=3

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=logs/agent.log

# Response Configuration
MAX_ANSWER_LENGTH=2000
INCLUDE_SOURCES=true
INCLUDE_CONFIDENCE=true
INCLUDE_EXECUTION_PLAN=true

# ================================
# LLM Configuration (本地 vllm 服务）
# ================================

# LLM 服务地址（OpenAI 兼容 API）
# 示例：本地 vllm 服务
LLM_BASE_URL=http://localhost:8000/v1

# 示例：远程 vllm 服务
# LLM_BASE_URL=http://your-server:8000/v1

# 示例：带路径的 vllm 服务
# LLM_BASE_URL=http://localhost:8000/v1

# LLM 模型名称
# 示例：Qwen 模型
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# 示例：其他模型
# LLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
# LLM_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
# LLM_MODEL_NAME=THUDM/glm-4-9b-chat

# API Key（如果需要）
# 本地 vllm 通常不需要，可以留空
LLM_API_KEY=

# 上下文长度（token 数）
LLM_CONTEXT_LENGTH=4096

# 最大生成 token 数
LLM_MAX_TOKENS=2048

# 温度参数（0.0-2.0，越低越确定性）
LLM_TEMPERATURE=0.7

# Top-P 采样（0.0-1.0）
LLM_TOP_P=0.9

# Top-K 采样（1-100）
LLM_TOP_K=50

# 响应格式（json_object 或 text）
LLM_RESPONSE_FORMAT=json_object

# 请求超时（秒）
LLM_TIMEOUT=60

# 最大重试次数
LLM_MAX_RETRIES=3

# API 版本（通常是 v1）
LLM_API_VERSION=v1

# ================================
# Jira OAuth Configuration (用于 JQL Action Server）
# ================================

# Atlassian 域名
# 示例：your-company
ATLASSIAN_DOMAIN=your-company

# Jira OAuth Client ID（从 Atlassian 开发者控制台获取）
JIRA_CLIENT_ID=your_client_id_here

# Jira OAuth Client Secret（从 Atlassian 开发者控制台获取）
JIRA_CLIENT_SECRET=your_client_secret_here

# Jira Cloud ID（从 Jira 系统信息中获取）
# 格式示例：a1b2c3d4-5e6f-7g8h-9i0j-1k2l3m4n5o6p
JIRA_CLOUD_ID=your_cloud_id_here

# ================================
# Action Server Configuration
# ================================

# Action Server 监听地址
ACTION_SERVER_HOST=0.0.0.0

# Action Server 监听端口
ACTION_SERVER_PORT=8000

# Action Server 日志级别（DEBUG, INFO, WARNING, ERROR）
ACTION_SERVER_LOG_LEVEL=INFO
